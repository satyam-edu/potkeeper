# Room server (Cloudflare Worker) + Vercel: same value in both
JWT_SECRET=
SETTLE_SECRET=
# Room server only
SETTLE_URL=            # e.g. https://potkeeper.tech/api/games/settle
# Vercel only
MONGODB_URI=
GOOGLE_CLIENT_ID=
# Local dev: copy to .env. The room server reads .dev.vars (JWT_SECRET, SETTLE_SECRET, SETTLE_URL): same JWT_SECRET and SETTLE_SECRET as .env.
# Production: `npx wrangler secret put JWT_SECRET` (and SETTLE_SECRET, SETTLE_URL)
# Vite (client)
# Local dev: leave unset (it follows the page address, so phones on your Wi-Fi work too). Production: the Worker host.
# VITE_ROOM_HOST=potkeeper.<account>.workers.dev
VITE_GOOGLE_CLIENT_ID=
