# PartyKit + Vercel (same value in both)
JWT_SECRET=
SETTLE_SECRET=
# PartyKit only
SETTLE_URL=            # e.g. https://potkeeper.tech/api/games/settle
# Vercel only
MONGODB_URI=
GOOGLE_CLIENT_ID=
# Local dev: copy to .env. Use the same JWT_SECRET for `npx partykit dev --var JWT_SECRET=...`
# Vite (client)
VITE_PARTYKIT_HOST=localhost:1999
VITE_GOOGLE_CLIENT_ID=
